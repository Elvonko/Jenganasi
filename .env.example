DATABASE_URL=postgresql://user:password@localhost:5432/jenganasi
DATABASE_POOL_MAX=10
# Optional: integration tests set this to a unique schema for isolation
DATABASE_SCHEMA=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated additional allowed origins for auth callbacks and redirects
BETTER_AUTH_TRUSTED_ORIGINS=
# SMTP is required in production to send verification and password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=JengaNasi <no-reply@example.com>
