DATABASE_URL=postgresql://user:password@localhost:5432/jenganasi
DATABASE_POOL_MAX=10
# Optional: integration tests set this to a unique schema for isolation
DATABASE_SCHEMA=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated additional allowed origins for auth callbacks and redirects
BETTER_AUTH_TRUSTED_ORIGINS=
# SMTP is required in production to send verification and password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=JengaNasi <no-reply@example.com>
# M-Pesa Daraja (sandbox by default; set production only with live credentials)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# Public HTTPS URL that Daraja can reach: https://your-domain/api/mpesa/callback
MPESA_CALLBACK_URL=
# Optional error reporting (install @sentry/node to enable)
SENTRY_DSN=
# S3-compatible object storage for media (omit to keep bytes in Postgres)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
