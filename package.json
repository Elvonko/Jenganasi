{
  "name": "jenganasi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local --import=tsx scripts/migrate.ts",
    "db:backup": "node --env-file-if-exists=.env.local --import=tsx scripts/backup.ts",
    "db:restore": "node --env-file-if-exists=.env.local --import=tsx scripts/restore.ts",
    "db:drill": "npm run db:backup -- .backups/latest.dump && npm run db:restore -- .backups/latest.dump",
    "test": "node --env-file-if-exists=.env.local --conditions=react-server --import=tsx --test src/db/migrate.test.ts src/lib/project-service.test.ts src/lib/procurement-service.test.ts"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.65.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
